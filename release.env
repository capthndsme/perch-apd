# Fields of the next release's signed manifest (agent-updates protocol.md 1.1),
# read by the release workflow (.github/workflows/openwrt.yml) and by
# scripts/local-release.sh. Empty = null. Set them in the release commit.
#
#   MIN_VERSION             the floor: a device that confirms this release never
#                           accepts an older one afterwards (a security release)
#   MIN_FROM_VERSION        installs only over this version or newer (a stepping stone)
#   MIN_CONTROLLER_VERSION  controllers older than this do not offer it
MIN_VERSION=
MIN_FROM_VERSION=
MIN_CONTROLLER_VERSION=
