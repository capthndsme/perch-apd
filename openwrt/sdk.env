# OpenWrt releases and package architectures the packages are built for, with
# the official SDK images (docker.io/openwrt/sdk:<arch>-<release>). The release
# workflow's matrix and scripts/openwrt-package.sh both read this file, so a new
# OpenWrt point release is a one-line change here.
#
#   24.10.x  opkg, .ipk
#   25.12.x  apk-tools, .apk
#
#   mipsel_24kc               ramips mt7621 / mt7628 (Archer AX23, most MT7621 routers)
#   mips_24kc                 ath79 (Archer C7, most Qualcomm Atheros 11ac routers)
#   aarch64_cortex-a53        mediatek filogic (MT7981, MT7986), qualcommax ipq807x
#   arm_cortex-a7_neon-vfpv4  ipq40xx
#   x86_64                    x86/64 (PCs, VMs, containers)
OPENWRT_RELEASES="24.10.8 25.12.5"
OPENWRT_ARCHES="mipsel_24kc mips_24kc aarch64_cortex-a53 arm_cortex-a7_neon-vfpv4 x86_64"
