# perch-apd: Perch AP Daemon.
#
# `perch-apd join --controller <url> --token <token>` fills in the first
# two options and restarts the service; so does `perch-apd --install`.
# After a manual edit: /etc/init.d/perch-apd restart
config agent 'main'
	option enabled '1'

	# The Perch Network Controller, e.g. 'https://perch.example.com'.
	option controller ''

	# Join token from the dashboard: Settings → Wi-Fi sources → New join token.
	# Used once; cleared after a successful join.
	option join_token ''

	# Issued by the controller when the daemon joins. Do not edit; forgetting
	# the agent in the dashboard revokes them.
	option agent_id ''
	option agent_secret ''

	# Accept a self-signed certificate on an https controller ('1'), or trust
	# an extra CA bundle (PEM file).
	option tls_insecure '0'
	option ca_file ''

	# Send the Ethernet ports (link, speed, duplex) with every push, for the
	# controller's infrastructure view. '0' leaves them out.
	option ports '1'

	# Device groups (controller Settings → Device groups): let the controller
	# put the groups' Wi-Fi keys and bindings on this AP's shared SSIDs, with
	# the VLANs they land in carried tagged to the gateway ('1'). It writes
	# only Perch's own sections of /etc/config/wireless and network and rolls
	# back unless the controller confirms. Over a plain http:// controller it
	# also needs wifi_groups_insecure '1'.
	option wifi_groups '0'
	option wifi_groups_insecure '0'

	# Wi-Fi management (controller: WiFi): what the controller may do with
	# this AP's Wi-Fi configuration, /etc/config/wireless and the VLANs it
	# needs in /etc/config/network (nothing else, never this file).
	# 'none': nothing. 'read': see it, passphrases only as fingerprints, and
	# hear about every change. 'write': change it too; every change is rolled
	# back unless the AP reaches the controller again and its radios and
	# networks come up. `perch-apd wifi access none|read|write` sets it.
	option wifi_config 'read'
	list wifi_config_allow 'wireless'
	list wifi_config_allow 'network'
	# Changes need an https controller with a verified certificate; '1' also
	# accepts signed changes over plain http:// (needs a pairing).
	option wifi_config_insecure '0'
	# The longest a change may wait for its confirm, seconds (30-1800).
	option wifi_config_confirm_max '900'

	# debug, info, warn or error (logread -e perch-apd).
	option log_level 'info'
