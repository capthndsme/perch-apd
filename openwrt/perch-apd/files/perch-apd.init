#!/bin/sh /etc/rc.common
# perch-apd: Perch AP Daemon (metrics + controller bridge).
# Configuration: /etc/config/perch-apd. Logs: logread -e perch-apd

START=95
STOP=10
USE_PROCD=1

NAME=perch-apd
CONF=/etc/config/perch-apd

# The opkg/apk package installs to /usr/bin, `perch-apd --install` to /opt.
PROG=/usr/bin/perch-apd
[ -x "$PROG" ] || PROG=/opt/perch-apd/perch-apd

start_service() {
	local enabled controller

	config_load "$NAME"
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get controller main controller
	if [ -z "$controller" ]; then
		logger -t "$NAME" "not configured; run: perch-apd join --controller <url> --token <token>"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG" run --config "$CONF"
	# Restart on `reload` when the file changed (the daemon stores its
	# credentials there itself; that only matters at the next reload).
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
